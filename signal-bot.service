[Unit]
Description=VOOI Signal Bot — Automated Crypto Trading Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/signal-bot
EnvironmentFile=/opt/signal-bot/.env
ExecStart=/opt/signal-bot/.venv/bin/python -m bot run
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal-bot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/signal-bot/logs /opt/signal-bot

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
