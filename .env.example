# =============================================================================
# VOOI Signal Bot — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram (required for signal ingestion)
# Get API_ID and API_HASH from https://my.telegram.org/apps
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=signal_bot

# Send a Telegram alert to the operator on each successfully parsed signal.
# Useful for quality monitoring (no money involved) during initial onboarding.
SIGNAL_CHECKPOINT_NOTIFY_TELEGRAM=false

# -----------------------------------------------------------------------------
# VOOI Ultra API
# API key is obtained from VOOI (https://vooi.io). Keys are perpetual.
# Broker identity and fees are assigned by VOOI server-side based on the API
# key — the bot does not send VOOI_BROKER_ID_* or VOOI_BROKER_FEE_BPS_*.
# -----------------------------------------------------------------------------
VOOI_API_BASE_URL=https://perps-api.vooi.io
VOOI_API_KEY=

# -----------------------------------------------------------------------------
# LLM Provider (for signal parsing)
# Supported: openai
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Bump this on any prompt change to track parsing quality regressions.
SIGNAL_PARSER_PROMPT_VERSION=v1.0

# -----------------------------------------------------------------------------
# Database
# Format: postgresql+asyncpg://user:password@host:port/dbname
# -----------------------------------------------------------------------------
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me_before_production
DATABASE_URL=postgresql+asyncpg://botuser:change_me_before_production@localhost:5432/signalbot

# -----------------------------------------------------------------------------
# Trading Defaults
# -----------------------------------------------------------------------------
DEFAULT_LEVERAGE=5
MAX_LEVERAGE=10
DEFAULT_MARGIN_MODE=cross

# % of available margin used as collateral per trade.
DEFAULT_POSITION_SIZE_PCT=5

# Absolute notional cap per trade in USD (prevents runaway sizing).
MAX_POSITION_SIZE_USD=1000

# Stop-loss: maximum % of MARGIN to lose on a single trade.
# Effective price distance from entry = DEFAULT_SL_PCT / leverage.
# At lev=5: 5% margin → 1.0% price. At lev=10: 5% margin → 0.5% price.
DEFAULT_SL_PCT=5

# USE_SIGNAL_SL: whether to honor an explicit stop_loss from the signal.
#   true  → use signal SL when present, fallback to DEFAULT_SL_PCT otherwise.
#   false → always use DEFAULT_SL_PCT (hard-cap margin loss regardless of signal).
USE_SIGNAL_SL=false

# -----------------------------------------------------------------------------
# Take Profit (all *_PCT values are % of MARGIN; ÷ leverage for price distance)
# TP price = entry ± [required_gain + max(actual_overhead_bps, TP_OVERHEAD_FLOOR_PCT)]
#   required_gain = MIN_PROFIT_PCT_OF_COLLATERAL / 100 / leverage
#   floor         = TP_OVERHEAD_FLOOR_PCT       / 100 / leverage
# -----------------------------------------------------------------------------
MIN_PROFIT_PCT_OF_COLLATERAL=3
FUNDING_COST_BUFFER_BPS=5

# Floor on the cost-overhead component of TP (% of margin). 0 = disabled.
# Guarantees TP is never placed so close that real fees eat the profit.
TP_OVERHEAD_FLOOR_PCT=2

# Move SL to breakeven when unrealised profit reaches this % of MARGIN.
# Price-distance threshold = BREAKEVEN_TRIGGER_PCT / leverage.
BREAKEVEN_TRIGGER_PCT=0.5

# -----------------------------------------------------------------------------
# Fee Fallbacks (used when GET /exchange/quotes is unavailable; bps)
# Taker fee only — builder fee is added on top.
# -----------------------------------------------------------------------------
FEE_FALLBACK_TAKER_BPS_HYPERLIQUID=4.5
FEE_FALLBACK_TAKER_BPS_LIGHTER=0.0
FEE_FALLBACK_TAKER_BPS_ASTER=3.5

# How long to keep unfilled limit orders before auto-cancelling (hours).
LIMIT_ORDER_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Minimum Notional Per Exchange (USD) — orders below this are rejected.
# -----------------------------------------------------------------------------
MIN_NOTIONAL_USD_HYPERLIQUID=10
MIN_NOTIONAL_USD_LIGHTER=10
MIN_NOTIONAL_USD_ASTER=10

# -----------------------------------------------------------------------------
# Risk Circuit Breakers
# -----------------------------------------------------------------------------
MAX_PLACEMENTS_PER_HOUR_GLOBAL=10
MAX_PLACEMENTS_PER_HOUR_PER_CHANNEL=3

# Pause new entries if daily drawdown exceeds this % of account equity.
DAILY_DD_PCT_PAUSE=10

# -----------------------------------------------------------------------------
# SSE / Polling Intervals
# -----------------------------------------------------------------------------
TELEGRAM_POLL_INTERVAL_SEC=60
RECONCILER_INTERVAL_SEC=60
SSE_RECONNECT_BACKOFF_SEC=2
SSE_PRICE_STALENESS_THRESHOLD_SEC=30

# -----------------------------------------------------------------------------
# Alerting — outbound Telegram notifications to the operator.
# Create a bot via @BotFather, add it to your chat, copy the chat_id.
# Leave both empty to disable alerts (events still go to ./logs/bot.log).
# -----------------------------------------------------------------------------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/bot.log
VOOI_RAW_LOG_PATH=./logs/vooi-raw.log
# Verbose per-request NDJSON for aster calls (headers + bodies + fly-request-id),
# for diagnosing intermittent aster "401 Invalid credentials" failures.
ASTER_DEBUG_LOG_PATH=./logs/aster-debug.log
LOG_RETENTION_DAYS=30
